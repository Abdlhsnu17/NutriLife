{
  "name": "nutri-life",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev --workspace @nutrilife/web",
    "dev:web": "npm run dev --workspace @nutrilife/web",
    "dev:backend": "npm run dev --workspace @nutrilife/api",
    "dev:api": "npm run dev:backend",
    "dev:all": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "db:up": "docker compose up -d mysql",
    "db:setup-local": "node scripts/setup-local-mysql.mjs",
    "db:check": "node scripts/check-db.mjs",
    "db:migrate": "docker compose exec -T mysql mysql -unutrilife -pnutrilife nutrilife < database/migrations/migrate.sql",
    "db:import-recipes": "npm run import:recipes --workspace @nutrilife/api --",
    "db:import-fastfood": "npm run import:fastfood --workspace @nutrilife/api --",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @nutrilife/web",
    "build:api": "npm run build --workspace @nutrilife/api",
    "start": "npm run start --workspace @nutrilife/web",
    "start:api": "npm run start --workspace @nutrilife/api"
  },
  "devDependencies": {"concurrently": "^9.2.1"}
}
