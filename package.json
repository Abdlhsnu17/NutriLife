{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:api": "npm run dev:backend",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "db:up": "docker compose up -d mysql",
    "db:setup-local": "node scripts/setup-local-mysql.mjs",
    "db:check": "node scripts/check-db.mjs",
    "db:migrate": "docker compose exec -T mysql mysql -unutrilife -pnutrilife nutrilife < database/migrate.sql",
    "db:import-recipes": "tsx backend/src/import-recipes.ts",
    "db:import-fastfood": "tsx backend/src/import-fastfood.ts",
    "build": "next build --webpack",
    "build:api": "tsc -p backend/tsconfig.json",
    "start": "next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.16.0",
    "mysql2": "^3.15.3",
    "next": "16.3.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.7.3"
  }
}
